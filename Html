<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Landing Page</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="header">
    <nav class="navbar">
      <h2 class="logo">Aadi Tech</h2>
      <ul>
        <li><a href="#">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>

    <div class="hero">
      <h1>Welcome to My Landing Page</h1>
      <p>Your all-in-one platform for intelligent web innovation.</p>
      <a href="#services" class="btn">Learn More</a>
    </div>
  </header>

  <section id="about" class="about">
    <h2>About Us</h2>
    <p>Our mission is to merge creativity with technology to deliver powerful digital transformation.</p>
  </section>

  <section id="services" class="services">
    <h2>Our Services</h2>
    <div class="service-box">
      <h3>Cyber security</h3>
      <p>Dynamic, scalable cybersecurity solutions tailored to your business environment.</p>
    </div>
    <div class="service-box">
      <h3>SEO Optimization</h3>
      <p>Enhance your threat visibility" refers to increasing awareness and capability in detecting cyber threats, crucial for cybersecurity offerings.</p>
    </div>
  </section>

  <section id="contact" class="contact">
    <h2>Contact Us</h2>
    <form>
      <input type="text" placeholder="Your Name" required>
      <input type="email" placeholder="Your Email" required>
      <textarea placeholder="Your Message" rows="4" required></textarea>
      <button type="submit">Send Message</button>
    </form>
  </section>

  <footer class="footer">
    <p>© 2025  Aadi Tech. All rights reserved.</p>
  </footer>
</body>
</html>
